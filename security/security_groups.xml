<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Module Category for CQS Permissions (renders as dropdown: None / Viewer / Admin) -->
    <record id="module_category_infs_cqs" model="ir.module.category">
        <field name="name">CQS Qualification</field>
        <field name="description">User access level for Client Qualification Scorecard (FRM-SAL-01)</field>
        <field name="sequence">25</field>
    </record>

    <!-- Viewer Group -->
    <record id="group_cqs_viewer" model="res.groups">
        <field name="name">Viewer</field>
        <field name="category_id" ref="module_category_infs_cqs"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Admin Group -->
    <record id="group_cqs_admin" model="res.groups">
        <field name="name">Admin</field>
        <field name="category_id" ref="module_category_infs_cqs"/>
        <field name="implied_ids" eval="[(4, ref('group_cqs_viewer'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
